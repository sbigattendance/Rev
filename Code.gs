/** Revive v4. Run setupRevive_ from the editor. Never deploy alongside the old public pull API. */
const RF_SCHEMA_={
 Members:['id','date','status','firstName','lastName','fullName','primaryContact','alternateContact','dob','address','admissionCategory','trainingCategory','previousId','billingEnd','photoId','signatureId','createdAt','createdBy','updatedAt'],
 Charges:['id','memberId','type','period','amount','promoName','createdAt'],
 Transactions:['id','receiptId','memberId','memberName','phone','chargeId','period','type','amount','mode','reference','staffId','staffName','createdAt','detailsJson'],
 Attendance:['id','memberId','name','date','time','createdAt','markedBy'],
 Expenses:['id','date','amount','category','mode','description','staffId','staffName','createdAt'],
 Staff:['id','name','role','pinHash','active','authVersion','createdAt'],
 Tariffs:['id','admissionFee','regularFee','ptFee'],
 Promotions:['id','name','startDate','endDate','admissionFee','regularFee','ptFee','active','createdAt'],
 Products:['id','name','description','price','stock','active','updatedAt'],
 Settings:['id','value'], Media:['id','part','content'],
 Requests:['id','action','payloadHash','statusHash','resultJson','createdAt'],
 Audit:['id','actorId','actorName','action','recordId','createdAt','detail']
};
const RF_WRITE_=['admit','payFee','markAttendance','saveMember','archiveMember','restoreMember','saveExpense','saveTariffs','savePromotion','saveSettings','saveStaff','revokeStaff','changePin','saveProduct','sale'];
function props_(){return PropertiesService.getScriptProperties();}
function db_(){const id=props_().getProperty('SPREADSHEET_ID');if(!id)fail_('Complete Apps Script setup first.');return SpreadsheetApp.openById(id);}
function now_(){return new Date().toISOString();}
function today_(){return Utilities.formatDate(new Date(),'Asia/Kolkata','yyyy-MM-dd');}
function uuid_(){return Utilities.getUuid();}
function hash_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(s),Utilities.Charset.UTF_8).map(b=>(b+256).toString(16).slice(-2)).join('');}
function pinHash_(pin){const pepper=props_().getProperty('PIN_PEPPER');if(!pepper)fail_('PIN configuration is missing.');return hash_(pepper+':'+pin);}
function validPin_(pin){if(!/^\d{6,12}$/.test(String(pin)))fail_('Use a unique PIN of 6 to 12 digits.');return String(pin);}
function clean_(o){const r={};Object.keys(o||{}).filter(k=>!k.startsWith('_')).forEach(k=>r[k]=o[k]);return r;}
function safeStaff_(s){return {id:s.id,name:s.name,role:s.role,active:s.active};}
function setupRevive_(){
 const p=props_(),bound=SpreadsheetApp.getActiveSpreadsheet();if(!p.getProperty('SPREADSHEET_ID')&&bound)p.setProperty('SPREADSHEET_ID',bound.getId());
 const ss=db_();ss.setSpreadsheetTimeZone('Asia/Kolkata');
 Object.keys(RF_SCHEMA_).forEach(name=>{let sh=ss.getSheetByName('RF_'+name);if(!sh){sh=ss.insertSheet('RF_'+name);sh.getRange(1,1,1,RF_SCHEMA_[name].length).setValues([RF_SCHEMA_[name]]);sh.setFrozenRows(1);}});
 if(!p.getProperty('PIN_PEPPER'))p.setProperty('PIN_PEPPER',uuid_()+uuid_());
 if(!p.getProperty('ALLOWED_ORIGINS'))p.setProperty('ALLOWED_ORIGINS','https://sbigattendance.github.io');
 const d=new Store_();if(!d.rows('Staff').length){const pin=validPin_(p.getProperty('INITIAL_ADMIN_PIN'));d.put('Staff',{id:'ADMIN',name:'Administrator',role:'admin',pinHash:pinHash_(pin),active:true,authVersion:1,createdAt:now_()});}
 const defaults={studioName:'Revive Fitness Studio',address:'Kadayil Arcade, Thanal Nagar, Keralapuram, Keralam 691504',phone:'8921698044',upiId:'',admissionFee:850,regularFee:800,ptFee:1500,readmissionBasis:'lastAttendance',version:1};
 Object.entries(defaults).forEach(([id,value])=>{if(!d.get('Settings',id))d.put('Settings',{id,value:JSON.stringify(value)});});d.commit();p.deleteProperty('INITIAL_ADMIN_PIN');return 'Setup complete. Deploy the web app and configure its URL.';
}
class Store_ {
 constructor(){this.ss=db_();this.tables={};this.pending={};}
 rows(name){if(!RF_SCHEMA_[name])fail_('Unknown table.');if(!this.tables[name]){const sh=this.ss.getSheetByName('RF_'+name);if(!sh)fail_('Run setupRevive_ before using the portal.');const values=sh.getDataRange().getValues(),headers=values[0];if(RF_SCHEMA_[name].some((h,i)=>headers[i]!==h))fail_('Unexpected columns in RF_'+name+'. Restore the original headers.');this.tables[name]=values.slice(1).map((row,i)=>Object.assign({_row:i+1},Object.fromEntries(headers.map((h,j)=>[h,row[j] instanceof Date?row[j].toISOString():row[j]])))).filter(r=>r.id!=='');}return this.tables[name];}
 get(name,id){return this.rows(name).find(r=>String(r.id)===String(id));}
 put(name,obj){let row=this.get(name,obj.id);if(row)Object.assign(row,obj);else{row={...obj};this.rows(name).push(row);}this.pending[name+':'+obj.id]=[name,row];return row;}
 append(name,obj){if(this.get(name,obj.id))fail_('Duplicate record identifier.');return this.put(name,obj);}
 media(data){if(!/^data:image\/(jpeg|png);base64,[A-Za-z0-9+/=]+$/.test(data||'')||data.length>240000)fail_('Upload a JPG or PNG below the compressed size limit.');const group='IMG-'+uuid_();for(let i=0;i<data.length;i+=35000)this.append('Media',{id:group+':'+i,part:group,content:data.slice(i,i+35000)});return group;}
 readMedia(id){return id?this.rows('Media').filter(r=>r.part===id).map(r=>r.content).join(''):'';}
 commit(){const requests=[],appends={};Object.values(this.pending).forEach(([name,row])=>{const sh=this.ss.getSheetByName('RF_'+name);const cells=RF_SCHEMA_[name].map(h=>{const v=row[h]??'';return {userEnteredValue:typeof v==='number'?{numberValue:v}:typeof v==='boolean'?{boolValue:v}:{stringValue:String(v)}};});if(row._row!==undefined)requests.push({updateCells:{start:{sheetId:sh.getSheetId(),rowIndex:row._row,columnIndex:0},rows:[{values:cells}],fields:'userEnteredValue'}});else{if(!appends[name])appends[name]=[];appends[name].push({values:cells});}});Object.entries(appends).forEach(([name,rows])=>requests.push({appendCells:{sheetId:this.ss.getSheetByName('RF_'+name).getSheetId(),rows,fields:'userEnteredValue'}}));if(requests.length)Sheets.Spreadsheets.batchUpdate({requests},this.ss.getId());this.pending={};}
}
function settings_(d){return Object.fromEntries(d.rows('Settings').map(r=>{let v;try{v=JSON.parse(r.value);}catch{v=r.value;}return [r.id,v];}));}
function authenticate_(d,pin,role){const cache=CacheService.getScriptCache(),key='rf.failedLogins';if(Number(cache.get(key)||0)>=30)fail_('Too many failed PIN attempts. Wait five minutes.');const h=pinHash_(String(pin||''));const u=d.rows('Staff').find(s=>s.active===true&&s.pinHash===h&&(!role||s.role===role));if(!u){cache.put(key,String(Number(cache.get(key)||0)+1),300);fail_('PIN not accepted.');}cache.remove(key);return u;}
function session_(d,token,role){const data=CacheService.getScriptCache().get('rf.session.'+String(token||''));if(!data)fail_('Please sign in again.');const s=JSON.parse(data),u=d.get('Staff',s.id);if(!u||u.active!==true||u.authVersion!==s.authVersion)fail_('Access has expired or been revoked.');if(role&&u.role!==role)fail_('Admin access is required.');return u;}
function collector_(d,p){return authenticate_(d,p.collectorPin);}
function requiredMember_(d,id){const m=d.get('Members',id);if(!m)fail_('Member not found.');return m;}
function memberDetails_(d,m){return {...clean_(m),photo:d.readMedia(m.photoId),signature:d.readMedia(m.signatureId)};}
function audit_(d,u,action,id,detail){d.append('Audit',{id:uuid_(),actorId:u.id,actorName:u.name,action,recordId:id,createdAt:now_(),detail:text_(detail,1000)});}
function receipt_(d,id){const tx=d.rows('Transactions').filter(t=>t.receiptId===id);if(!tx.length)fail_('Receipt not found.');return {id,memberId:tx[0].memberId,memberName:tx[0].memberName,phone:tx[0].phone,createdAt:tx[0].createdAt,mode:tx[0].mode,reference:tx[0].reference,staffName:tx[0].staffName,lines:tx.map(clean_),total:money_(tx.reduce((s,t)=>s+Number(t.amount),0))};}
function addTx_(d,u,m,receiptId,charge,amount,mode,reference,details){d.append('Transactions',{id:'TX-'+uuid_(),receiptId,memberId:m?.id||'',memberName:m?.fullName||'Walk-in customer',phone:m?.primaryContact||'',chargeId:charge?.id||'',period:charge?.period||today_().slice(0,7),type:charge?.type||'Supplement',amount:money_(amount),mode,reference,staffId:u.id,staffName:u.name,createdAt:now_(),detailsJson:JSON.stringify(details||{})});}
function mode_(m){if(!['CASH','UPI'].includes(m))fail_('Choose Cash or UPI.');return m;}
function validateMember_(p){const m={date:date_(p.date),firstName:text_(p.firstName,60),lastName:text_(p.lastName,60),primaryContact:phone_(p.primaryContact),alternateContact:p.alternateContact?phone_(p.alternateContact):'',dob:date_(p.dob),address:text_(p.address,400),admissionCategory:p.admissionCategory,trainingCategory:p.trainingCategory};if(!m.firstName||!m.address)fail_('Name and address are required.');if(m.date>today_()||m.dob>m.date)fail_('Check the admission date and date of birth.');if(!['Individual','Family'].includes(m.admissionCategory)||!['Regular','Personal Training'].includes(m.trainingCategory))fail_('Choose valid admission and training categories.');m.fullName=[m.firstName,m.lastName].filter(Boolean).join(' ');return m;}
function checkPhone_(d,m,ignoreIds){const duplicates=d.rows('Members').filter(x=>!ignoreIds.includes(x.id)&&active_(x)&&x.primaryContact===m.primaryContact);if(duplicates.some(x=>m.admissionCategory==='Individual'||x.admissionCategory==='Individual'))fail_('This phone number belongs to an active individual member. Use that membership or another number.');if(duplicates.some(x=>x.fullName.toLowerCase()===m.fullName.toLowerCase()&&x.dob===m.dob))fail_('This family member is already registered.');}
function doGet(e){const p=e?.parameter||{},allowed=(props_().getProperty('ALLOWED_ORIGINS')||'').split(',').map(s=>s.trim());if(!allowed.includes(p.origin)||!/^https:\/\//.test(p.origin)||!/^[-a-zA-Z0-9]{20,100}$/.test(p.channel||''))return HtmlService.createHtmlOutput('Revive API. Open the configured portal to connect.');const t=HtmlService.createTemplateFromFile('Bridge');t.originJson=JSON.stringify(p.origin);t.channelJson=JSON.stringify(p.channel);return t.evaluate().setTitle('Revive Sheets connection').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
function reviveRpc(req){let lock,commitAttempted=false;try{
 if(!req||req.apiVersion!==4||typeof req.action!=='string')fail_('Unsupported portal version.');const p=req.payload||{},action=req.action,d=new Store_();
 if(RF_WRITE_.includes(action)){
  if(!/^[-a-zA-Z0-9]{20,100}$/.test(req.requestId||'')||!/^[-a-zA-Z0-9]{20,100}$/.test(req.statusSecret||''))fail_('Missing save identifier.');
  lock=LockService.getScriptLock();if(!lock.tryLock(15000))fail_('The sheet is busy. Please retry.');
  const bodyHash=hash_(JSON.stringify({action,payload:p})),prior=d.get('Requests',req.requestId);
  if(prior){if(prior.statusHash!==hash_(req.statusSecret)||prior.payloadHash!==bodyHash)fail_('This request ID was already used. Check the original save before changing it.');return JSON.parse(prior.resultJson);}
  const result=write_(d,req);const s=settings_(d);d.put('Settings',{id:'version',value:JSON.stringify(Number(s.version||0)+1)});
  const response={ok:true,data:result,serverTime:now_()};d.append('Requests',{id:req.requestId,action,payloadHash:bodyHash,statusHash:hash_(req.statusSecret),resultJson:JSON.stringify(response),createdAt:now_()});commitAttempted=true;d.commit();return response;
 }
 return {ok:true,data:read_(d,req),serverTime:now_()};
 }catch(e){return {ok:false,uncertain:commitAttempted,error:e.message||'Request failed.'};}finally{if(lock)lock.releaseLock();}}
function read_(d,r){const p=r.payload||{},s=settings_(d);switch(r.action){
 case 'health':return {apiVersion:4,today:today_(),settings:s};
 case 'login':{const u=authenticate_(d,p.pin,p.role);const token=uuid_()+uuid_();CacheService.getScriptCache().put('rf.session.'+token,JSON.stringify({id:u.id,authVersion:u.authVersion}),7200);return {token,user:safeStaff_(u)};}
 case 'logout':CacheService.getScriptCache().remove('rf.session.'+String(r.token||''));return {signedOut:true};
 case 'requestStatus':{const record=d.get('Requests',p.requestId);if(!record||record.statusHash!==hash_(p.statusSecret))return {found:false};return {found:true,response:JSON.parse(record.resultJson)};}
 case 'quoteAdmission':{const m=validateMember_(p);if(p.previousId){session_(d,r.token);const prior=requiredMember_(d,p.previousId);if(prior.status==='Readmitted'||!eligibleReadmission_(prior,d.rows('Attendance'),m.date,s.readmissionBasis).eligible)fail_('This membership is not eligible for readmission.');}checkPhone_(d,m,p.previousId?[p.previousId]:[]);return admissionQuote_(m,d.rows('Tariffs'),d.rows('Promotions'),s);}
 case 'products':return d.rows('Products').filter(x=>x.active===true).map(clean_);
 case 'lookupAttendance':{const q=text_(p.query).toLowerCase();if(q.length<3)fail_('Enter a member ID, complete phone number, or at least three name characters.');let staff=null;if(r.token)staff=session_(d,r.token);let rows=d.rows('Members').filter(active_).filter(m=>m.id.toLowerCase()===q||m.primaryContact===q||(staff&&m.fullName.toLowerCase().includes(q)));return rows.slice(0,20).map(m=>({id:m.id,fullName:m.fullName,phone:'******'+m.primaryContact.slice(-4),present:d.rows('Attendance').some(a=>a.memberId===m.id&&a.date===today_())}));}
 case 'attendanceLogs':session_(d,r.token);return d.rows('Attendance').filter(a=>a.date===date_(p.date||today_())).map(clean_);
 case 'searchMembers':{session_(d,r.token);const q=text_(p.query).toLowerCase();if(q.length<2)fail_('Enter at least two characters.');return d.rows('Members').filter(m=>(p.includeArchived||active_(m))&&[m.id,m.fullName,m.primaryContact].some(v=>String(v).toLowerCase().includes(q))).slice(0,50).map(clean_);}
 case 'member':{session_(d,r.token);const m=requiredMember_(d,p.id);return {member:memberDetails_(d,m),calendar:calendar_(m,p.fy||fy_(today_()),d.rows('Charges'),d.rows('Transactions'),d.rows('Attendance'),d.rows('Tariffs'),d.rows('Promotions'),s,today_()),readmission:eligibleReadmission_(m,d.rows('Attendance'),today_(),s.readmissionBasis),receipts:[...new Set(d.rows('Transactions').filter(t=>t.memberId===m.id).map(t=>t.receiptId))]};}
 case 'receipt':session_(d,r.token);return receipt_(d,p.id);
 case 'expenses':session_(d,r.token,'admin');return d.rows('Expenses').slice().reverse().slice(0,100).map(clean_);
 case 'configuration':session_(d,r.token,'admin');return {settings:s,tariffs:d.rows('Tariffs').map(clean_),promotions:d.rows('Promotions').map(clean_),staff:d.rows('Staff').map(safeStaff_),products:d.rows('Products').map(clean_)};
 case 'report':session_(d,r.token,'admin');return report_(d,p);
 default:fail_('Unknown operation.');}}
function write_(d,r){const p=r.payload||{},s=settings_(d);let u;
 if(['admit','payFee','sale'].includes(r.action)){u=collector_(d,p);if(p.paymentConfirmed!==true)fail_('Confirm receipt of payment before saving.');if(p.mode==='UPI'&&!s.upiId)fail_('Configure the studio UPI ID first.');}
 if(!['admit','markAttendance'].includes(r.action)){const signed=session_(d,r.token);if(!u)u=signed;}
 const adminActions=['archiveMember','restoreMember','saveExpense','saveTariffs','savePromotion','saveSettings','saveStaff','revokeStaff','saveProduct'];
 if(adminActions.includes(r.action))u=session_(d,r.token,'admin');
 switch(r.action){
 case 'admit':{
  const m=validateMember_(p),prior=p.previousId?requiredMember_(d,p.previousId):null;
  if(prior){session_(d,r.token);const eligibility=eligibleReadmission_(prior,d.rows('Attendance'),m.date,s.readmissionBasis);if(!eligibility.eligible)fail_('Readmission is eligible from '+eligibility.eligibleOn+'. Continue the existing membership before that date.');if(prior.status==='Readmitted')fail_('This registration already has a readmission. Select the latest membership.');}
  checkPhone_(d,m,prior?[prior.id]:[]);if(!p.photo||!p.signature||p.consent!==true)fail_('Photo, signature and member acceptance are required.');
  const q=admissionQuote_(m,d.rows('Tariffs'),d.rows('Promotions'),s);if(money_(p.expectedTotal)!==q.total)fail_('The tariff changed. Refresh the fee summary before collecting payment.');
  m.id=nextMemberId_(d.rows('Members'));m.status='Active';m.previousId=prior?.id||'';m.billingEnd='';m.createdAt=now_();m.createdBy=u.id;m.updatedAt=m.createdAt;m.photoId=d.media(p.photo);m.signatureId=d.media(p.signature);d.append('Members',m);
  if(prior)d.put('Members',{...prior,status:'Readmitted',billingEnd:previousMonth_(m.date.slice(0,7)),updatedAt:now_()});
  const charges=[{id:m.id+':admission',memberId:m.id,type:'Admission',period:q.period,amount:q.admissionFee,promoName:q.promoName,createdAt:now_()},{id:m.id+':training:'+q.period,memberId:m.id,type:'Fee',period:q.period,amount:q.trainingFee,promoName:q.promoName,createdAt:now_()}];
  const receiptId='RCT-'+uuid_();charges.forEach(c=>{d.append('Charges',c);addTx_(d,u,m,receiptId,c,c.amount,mode_(p.mode),text_(p.reference,80));});audit_(d,u,'admission',m.id,prior?'Readmission of '+prior.id:'New membership');return {memberId:m.id,receipt:receipt_(d,receiptId)};
 }
 case 'payFee':{
  const m=requiredMember_(d,p.memberId),period=month_(p.period);if(!active_(m))fail_('This membership is not active.');const cal=calendar_(m,fy_(period+'-01'),d.rows('Charges'),d.rows('Transactions'),d.rows('Attendance'),d.rows('Tariffs'),d.rows('Promotions'),s,today_()).find(x=>x.period===period);if(!cal)fail_('This month falls outside the membership billing period.');const amount=money_(p.amount);if(amount<=0||amount>cal.due)fail_('Amount must be above zero and no more than the live balance of ₹'+cal.due+'.');let c=d.get('Charges',cal.chargeId);if(!c)c=d.append('Charges',{id:cal.chargeId,memberId:m.id,type:'Fee',period,amount:cal.amount,promoName:'',createdAt:now_()});const receiptId='RCT-'+uuid_();addTx_(d,u,m,receiptId,c,amount,mode_(p.mode),text_(p.reference,80));audit_(d,u,'fee',m.id,period+' ₹'+amount);return {receipt:receipt_(d,receiptId),balance:money_(cal.due-amount)};
 }
 case 'markAttendance':{
  const m=requiredMember_(d,p.memberId);if(!active_(m))fail_('Member is not active.');if(r.token)u=session_(d,r.token);else if(![m.id.toLowerCase(),m.primaryContact].includes(text_(p.identifier).toLowerCase()))fail_('Use the exact admission ID or registered phone.');const id=m.id+':'+today_();const existing=d.get('Attendance',id);if(existing)return {alreadyPresent:true,record:clean_(existing)};const row={id,memberId:m.id,name:m.fullName,date:today_(),time:Utilities.formatDate(new Date(),'Asia/Kolkata','HH:mm:ss'),createdAt:now_(),markedBy:u?.id||'Member kiosk'};d.append('Attendance',row);return {alreadyPresent:false,record:row};
 }
 case 'saveMember':{
  const old=requiredMember_(d,p.id),m=validateMember_({...old,...p,date:old.date,trainingCategory:old.trainingCategory});checkPhone_(d,m,[old.id]);const row={...old,...m,updatedAt:now_()};if(p.photo)row.photoId=d.media(p.photo);if(p.signature)row.signatureId=d.media(p.signature);d.put('Members',row);audit_(d,u,'editMember',old.id,'Contact, category or identity details updated');return {memberId:old.id};
 }
 case 'archiveMember':case 'restoreMember':{
  const old=requiredMember_(d,p.id);if(r.action==='restoreMember'){if(old.status==='Readmitted')fail_('Use the newer readmission record.');checkPhone_(d,old,[old.id]);d.put('Members',{...old,status:'Active',billingEnd:'',updatedAt:now_()});}else d.put('Members',{...old,status:'Archived',billingEnd:today_().slice(0,7),updatedAt:now_()});audit_(d,u,r.action,old.id,'Financial ledger preserved');return {memberId:old.id};
 }
 case 'saveExpense':{const amount=money_(p.amount);if(amount<=0)fail_('Expense must be above zero.');const row={id:'EXP-'+uuid_(),date:date_(p.date),amount,category:text_(p.category,80),mode:mode_(p.mode),description:text_(p.description,500),staffId:u.id,staffName:u.name,createdAt:now_()};if(row.date>today_())fail_('Future expense dates are not allowed.');d.append('Expenses',row);audit_(d,u,'expense',row.id,'₹'+amount);return row;}
 case 'saveTariffs':{const periods=fyPeriods_(p.fy);if(!Array.isArray(p.tariffs)||p.tariffs.length!==12)fail_('Provide all twelve monthly rates.');periods.forEach(id=>{const t=p.tariffs.find(x=>x.id===id);if(!t)fail_('Missing tariff for '+id);d.put('Tariffs',{id,admissionFee:money_(t.admissionFee),regularFee:money_(t.regularFee),ptFee:money_(t.ptFee)});});audit_(d,u,'tariffs',p.fy,'Updated monthly rates');return {saved:true};}
 case 'savePromotion':{const old=p.id?d.get('Promotions',p.id):null;const row={id:old?.id||'PROMO-'+uuid_(),name:text_(p.name,100),startDate:date_(p.startDate),endDate:date_(p.endDate),admissionFee:money_(p.admissionFee),regularFee:money_(p.regularFee),ptFee:money_(p.ptFee),active:p.active!==false,createdAt:old?.createdAt||now_()};if(!row.name||row.startDate>row.endDate)fail_('Check promotion name and dates.');d.put('Promotions',row);audit_(d,u,'promotion',row.id,row.active?'Saved':'Disabled');return row;}
 case 'saveSettings':{const fields=['upiId','studioName','address','phone','readmissionBasis'];fields.forEach(id=>{if(p[id]===undefined)return;let v=text_(p[id],400);if(id==='upiId'&&v&&!/^[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+$/.test(v))fail_('Enter a valid UPI ID.');if(id==='readmissionBasis'&&!['lastAttendance','admission'].includes(v))fail_('Choose a valid readmission rule.');d.put('Settings',{id,value:JSON.stringify(v)});});audit_(d,u,'settings','studio','Updated studio settings');return {saved:true};}
 case 'saveStaff':{const id=p.id||'STF-'+uuid_(),old=d.get('Staff',id),h=pinHash_(validPin_(p.pin));if(d.rows('Staff').some(x=>x.id!==id&&x.active===true&&x.pinHash===h))fail_('That PIN is already assigned.');const name=text_(p.name,100);if(!name)fail_('Enter the staff name.');d.put('Staff',{id,name,role:old?.role||'staff',pinHash:h,active:true,authVersion:Number(old?.authVersion||0)+1,createdAt:old?.createdAt||now_()});audit_(d,u,'staff',id,'Added or updated access');return {id};}
 case 'revokeStaff':{const target=d.get('Staff',p.id);if(!target||target.role==='admin')fail_('Only staff access can be revoked here.');d.put('Staff',{...target,active:false,authVersion:Number(target.authVersion)+1});audit_(d,u,'revokeStaff',target.id,'Access revoked');return {saved:true};}
 case 'changePin':{const signed=session_(d,r.token);authenticate_(d,p.currentPin,signed.role);if(pinHash_(p.currentPin)!==signed.pinHash)fail_('Current PIN does not match your account.');const h=pinHash_(validPin_(p.newPin));if(d.rows('Staff').some(x=>x.id!==signed.id&&x.active===true&&x.pinHash===h))fail_('That PIN is already assigned.');d.put('Staff',{...signed,pinHash:h,authVersion:Number(signed.authVersion)+1});audit_(d,signed,'changePin',signed.id,'PIN changed; prior sessions invalidated');return {saved:true,signInAgain:true};}
